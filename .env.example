# Copy to .env for local overrides. Every value is optional on a laptop:
# with no .env at all, KahDuke runs on SQLite with an in-memory channel layer.

DEBUG=True
SECRET_KEY=change-me-to-something-long-and-random

# Deliberately NOT set: DATABASE_URL. Leaving it unset means SQLite locally;
# Compose sets it to Postgres in containers.

# Uncomment to use Redis for Channels locally (docker run --rm -p 6379:6379 redis:7).
# Without it, the in-memory layer works for a single `runserver` process.
# REDIS_URL="redis://127.0.0.1:6379/0"
# REDIS_SOCKET_TIMEOUT=10
