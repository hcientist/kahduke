# Copy to .env for local overrides. Every value is optional on a laptop:
# with no .env at all, KahDuke runs on SQLite with an in-memory channel layer.

DEBUG=True
SECRET_KEY=change-me-to-something-long-and-random

# Deliberately NOT set: DATABASE_URL. Leaving it unset means SQLite locally;
# Compose sets it to Postgres in containers.

# Uncomment to use Redis for Channels locally (docker run --rm -p 6379:6379 redis:7).
# Without it, the in-memory layer works for a single `runserver` process.
# REDIS_URL="redis://127.0.0.1:6379/0"
# REDIS_SOCKET_TIMEOUT=10

# Optional: the KahDuke GitHub App, for private repos and committing kwizzes.
# See "Set up the GitHub App" in README.md. Public repos work without these.
# GITHUB_APP_SLUG=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_WEBHOOK_SECRET=

# Optional: social sign-in. GitHub reuses the GitHub App's client ID/secret
# unless these are set. Canvas sign-in goes through the Canvas API proxy.
# GITHUB_LOGIN_CLIENT_ID=
# GITHUB_LOGIN_CLIENT_SECRET=
# CANVAS_PROXY_URL=https://canvas.mhciael.com
# CANVAS_PROXY_CLIENT_ID=
# CANVAS_PROXY_CLIENT_SECRET=
